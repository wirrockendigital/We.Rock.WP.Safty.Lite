<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/bootstrap.php"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
         beStrictAboutTestsThatDoNotTestAnything="true">
    <testsuites>
        <testsuite name="We.Rock.WP.Safety.Lite">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
</phpunit>
