<?xml version="1.0"?>
<ruleset name="We.Rock.WP.Safety.Lite">
    <description>WordPress Coding Standards configuration for We.Rock.WP.Safety.Lite.</description>
    <arg name="basepath" value="."/>
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="8"/>
    <arg value="p"/>
    <!-- Existing advisory warnings do not fail the lint gate; errors still do. -->
    <arg name="warning-severity" value="0"/>
    <config name="testVersion" value="7.4-"/>
    <!-- The project uses namespaced class files and centralized translation wrappers. -->
    <rule ref="WordPress">
        <exclude name="WordPress.Files.FileName"/>
        <exclude name="WordPress.WP.I18n.NonSingularStringLiteralText"/>
    </rule>
    <rule ref="WordPress-Extra"/>
    <rule ref="WordPress-Docs"/>
    <rule ref="PHPCompatibilityWP"/>
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="140"/>
            <property name="absoluteLineLimit" value="180"/>
        </properties>
    </rule>
    <exclude-pattern>vendor/*</exclude-pattern>
    <file>../we-rock-wp-safety-lite.php</file>
    <file>bootstrap.php</file>
    <file>src</file>
</ruleset>
